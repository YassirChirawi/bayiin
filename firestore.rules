rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- HELPERS ---

    // Get the signed-in user's data (cached by Firestore rules for same request)
    // Sûr même si l'utilisateur n'a pas (encore) de doc users : renvoie {} au lieu de planter.
    function getUserData() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : {};
    }

    // Check if the user belongs to the store they are trying to access
    function belongsToStore(storeId) {
       // Primary check: JWT Claim (Fastest, supports queries) OR Fallback: Document lookup
       return (request.auth != null && request.auth.token.get('storeId', '') == storeId) || 
              (request.auth != null && getUserData().get('storeId', '') == storeId);
    }

    // Type Checks
    function isNumber(num) {
      return num is number || num is float || num is int;
    }

    // --- VALIDATORS ---


    // Validate Product
    function isValidProduct(data) {
       return data.keys().hasAll(['storeId', 'name', 'price', 'stock']) &&
              data.storeId != null &&
              data.name is string && data.name.size() > 0 &&
              isNumber(data.price) && data.price >= 0 &&
              isNumber(data.stock) && data.stock >= 0;
    }

    // Validate Order
    function isValidOrder(data) {
       return data.keys().hasAll(['storeId', 'status', 'price']) &&
              data.storeId != null &&
              data.storeId is string &&
              isNumber(data.price) && data.price >= 0 &&
              data.status in ['reçu', 'confirmation', 'packing', 'ramassage', 'livraison', 'reporté', 'livré', 'retour', 'retour en cours', 'annulé', 'pas de réponse', 'pending_catalog'];
    }

    // Validate Expense
    function isValidExpense(data) {
       return data.keys().hasAll(['storeId', 'amount', 'label']) &&
              data.storeId != null &&
              isNumber(data.amount) && data.amount > 0 &&
              data.label is string && data.label.size() > 0;
    }

    // Check if user is Super Admin
    function isSuperAdmin() {
      return request.auth != null && request.auth.token.get('role', '') == 'super_admin';
    }

    // Check if user is owner or manager (Excludes Staff)
    function isOwnerOrManager(storeId) {
      return request.auth != null && (
        get(/databases/$(database)/documents/stores/$(storeId)).data.ownerId == request.auth.uid ||
        (getUserData().get('storeId', '') == storeId && (request.auth.token.get('role', '') == 'manager' || getUserData().get('role', '') == 'manager'))
      );
    }

    // Validate Order Transitions
    // DOIT rester synchronisée avec src/utils/orderStateMachine.js (VALID_TRANSITIONS).
    function isValidTransition(from, to) {
      return (from == to) ||
             (from == 'reçu' && to in ['confirmation', 'packing', 'annulé']) ||
             (from == 'confirmation' && to in ['packing', 'livraison', 'annulé']) ||
             (from == 'packing' && to in ['ramassage', 'livraison', 'annulé']) ||
             (from == 'ramassage' && to in ['livraison', 'annulé']) ||
             (from == 'livraison' && to in ['livré', 'retour', 'retour en cours', 'annulé', 'pas de réponse', 'reporté']) ||
             (from == 'livré' && to == 'retour') ||
             (from == 'annulé' && to == 'reçu') ||
             (from == 'retour en cours' && to in ['retour', 'annulé']) ||
             (from == 'pas de réponse' && to in ['confirmation', 'livraison', 'annulé', 'reporté']) ||
             (from == 'reporté' && to in ['confirmation', 'livraison', 'annulé', 'pas de réponse']) ||
             (from == 'pending_catalog' && to in ['reçu', 'annulé']);
    }

    // Check if store exists and has public catalog enabled
    function isPublicCatalogEnabled(storeId) {
      return get(/databases/$(database)/documents/stores/$(storeId)).data.publicCatalogEnabled == true;
    }

    // Check if user is a Driver
    function isDriver(storeId) {
      return request.auth != null && getUserData().get('storeId', '') == storeId && request.auth.token.get('role', '') == 'driver';
    }

    // Check if the user owns the store
    function isStoreOwner(storeId) {
      return request.auth != null && get(/databases/$(database)/documents/stores/$(storeId)).data.ownerId == request.auth.uid;
    }

    // Check if user is a Franchise Admin
    function isFranchiseAdmin() {
      return request.auth != null && request.auth.token.get('role', '') == 'franchise_admin';
    }

    // Check if a store belongs to the franchise admin's franchise
    function inSameFranchise(storeId) {
      return request.auth != null && request.auth.token.get('franchiseId', '') == get(/databases/$(database)/documents/stores/$(storeId)).data.franchiseId;
    }

    // --- RULES ---

    // Super Admin Global Read
    match /{document=**} {
      allow read: if isSuperAdmin();
    }

    // Users collection
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isSuperAdmin());
      // SEC (P0-4): a user may only self-provision a profile pointing at a store they OWN,
      // and may not self-assign an escalating role (owner/staff/driver only). This closes the
      // tenant-hijack vector where an attacker set users/{uid}.storeId/role to a victim store.
      allow create: if request.auth != null && request.auth.uid == userId
                    && (!('storeId' in request.resource.data) || isStoreOwner(request.resource.data.storeId))
                    && (!('role' in request.resource.data) || request.resource.data.role in ['owner', 'staff', 'driver']);
      allow update: if request.auth != null && request.auth.uid == userId &&
                    !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'storeId', 'franchiseId']);
      allow write: if request.auth != null && isSuperAdmin();
    }

    // Market Benchmarks (Évolution 6 — Anonymized aggregated data)
    match /market_benchmarks/{segment}/{date} {
      allow read: if request.auth != null; // Any authenticated user can read benchmarks
      allow write: if false; // Only backend (admin SDK) writes benchmarks
    }

    // BAY-108 : reporting d'erreurs client (option B). Tout utilisateur authentifié peut consigner
    // une erreur ; seule la maintenance (super_admin) les lit. Jamais modifiable/supprimable.
    match /error_logs/{logId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && isSuperAdmin();
      allow update, delete: if false;
    }

    // Digest quotidien des erreurs prod (dailyErrorDigest, Admin SDK). Lecture super_admin
    // uniquement ; écriture réservée au backend (jamais depuis le client).
    match /system_alerts/{date} {
      allow read: if request.auth != null && isSuperAdmin();
      allow write: if false;
    }

    // Journal des actions support (suspension, promo, prolongation, changement de plan…).
    // Créé et lu uniquement par le super_admin ; append-only (jamais modifiable/supprimable).
    match /support_actions/{actionId} {
      allow create: if isSuperAdmin() && request.resource.data.adminId == request.auth.uid;
      allow read: if isSuperAdmin();
      allow update, delete: if false;
    }

    // Stores collection
    match /stores/{storeId} {
      // SEC (P0-5): prevent self-granting a paid plan at creation. Owners create their own
      // FREE store; privileged roles may provision stores on behalf of others.
      allow create: if request.auth != null && (
                      (request.resource.data.ownerId == request.auth.uid
                       && request.resource.data.plan == 'free'
                       && !request.resource.data.keys().hasAny(['stripeCustomerId', 'youcanChargeId', 'subscriptionSource', 'currentPeriodEnd']))
                      || isSuperAdmin()
                      || isFranchiseAdmin()
                    );
      // SEC-01: Restrict read to authenticated users related to the store, OR if publicCatalogEnabled is true
      allow get: if (request.auth != null && (isStoreOwner(storeId) || belongsToStore(storeId) || isSuperAdmin() || isFranchiseAdmin())) 
                  || resource.data.publicCatalogEnabled == true;
      allow list: if (request.auth != null && (resource.data.ownerId == request.auth.uid || isSuperAdmin() || isFranchiseAdmin())) 
                  || resource.data.publicCatalogEnabled == true;
      // Le super_admin (opérateur plateforme / support) peut tout modifier — y compris plan,
      // abonnement, testerMode, suspended, trialEndsAt. Le propriétaire, lui, ne peut jamais
      // s'auto-attribuer ces champs (sinon contournement du paywall : testerMode/trialEndsAt/promo).
      allow update: if isSuperAdmin() ||
                    (isStoreOwner(storeId) &&
                     !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                       'plan', 'subscriptionStatus', 'currentPeriodEnd', 'stripeCustomerId',
                       'subscriptionSource', 'youcanChargeId',
                       'testerMode', 'suspended', 'trialEndsAt'
                     ]));
      allow delete: if isStoreOwner(storeId) || isSuperAdmin();

      match /private/{document=**} {
        allow read, write: if isStoreOwner(storeId) || isSuperAdmin();
      }
      
      match /stats/{statId} {
         // SEC: Stats are written exclusively by Cloud Functions (Admin SDK bypasses rules).
         // Clients can read but NOT write to prevent data manipulation.
         allow read: if request.auth != null && (isOwnerOrManager(storeId) || isSuperAdmin());
         allow write: if false; // Cloud Functions use Admin SDK — no client writes needed
      }
      match /audit_logs/{logId} {
         allow read: if request.auth != null && (isOwnerOrManager(storeId) || isSuperAdmin() || (isFranchiseAdmin() && inSameFranchise(storeId)));
         allow create: if request.auth != null && (isStoreOwner(storeId) || belongsToStore(storeId) || isSuperAdmin());
         allow update, delete: if false;
      }
      match /automations/{autoId} {
         allow read: if request.auth != null && (isStoreOwner(storeId) || belongsToStore(storeId) || isSuperAdmin() || (isFranchiseAdmin() && inSameFranchise(storeId)));
         allow write: if request.auth != null && (isStoreOwner(storeId) || belongsToStore(storeId) || isSuperAdmin());
      }
      // BAY-105 : tâches produites par le moteur d'automatisation serveur.
      // Écrites uniquement par le backend (Admin SDK) ; les membres les lisent et peuvent
      // les marquer traitées (statut) depuis l'UI marchand.
      match /automation_tasks/{taskId} {
         allow read: if request.auth != null && (isStoreOwner(storeId) || belongsToStore(storeId) || isSuperAdmin());
         allow create: if false;
         allow update: if request.auth != null && (isStoreOwner(storeId) || belongsToStore(storeId) || isSuperAdmin());
         allow delete: if false;
      }
      match /whatsapp_tasks/{taskId} {
         allow read: if request.auth != null && (isStoreOwner(storeId) || belongsToStore(storeId) || isSuperAdmin());
         allow create: if false;
         allow update: if request.auth != null && (isStoreOwner(storeId) || belongsToStore(storeId) || isSuperAdmin());
         allow delete: if false;
      }
      match /pending_shipments/{taskId} {
         allow read: if request.auth != null && (isStoreOwner(storeId) || belongsToStore(storeId) || isSuperAdmin());
         allow create: if false;
         allow update: if request.auth != null && (isStoreOwner(storeId) || belongsToStore(storeId) || isSuperAdmin());
         allow delete: if false;
      }
      // BAY-107 : compteurs séquentiels (numéros de commande/client) — doc dédié séparé de
      // stats/sales pour éviter la contention et la corruption par le recalcul des stats.
      match /counters/{counterId} {
         allow read, write: if request.auth != null && (isStoreOwner(storeId) || belongsToStore(storeId) || isSuperAdmin());
      }
      match /qa_runs/{docId} {
         allow read, write: if request.auth != null && (isStoreOwner(storeId) || belongsToStore(storeId) || isSuperAdmin());
      }
      match /stock_logs/{logId} {
         allow read, write: if request.auth != null && (isStoreOwner(storeId) || belongsToStore(storeId) || isSuperAdmin());
      }
      match /beya3_memory/{memoryId} {
        allow read, write: if request.auth != null && (isStoreOwner(storeId) || belongsToStore(storeId) || isSuperAdmin());
      }
      match /beya3_conversations/{conversationId} {
        allow read: if request.auth != null && (isStoreOwner(storeId) || belongsToStore(storeId) || isSuperAdmin());
        allow write: if false; // Only backend writes to this log
        
        match /messages/{messageId} {
            allow read: if request.auth != null && (isStoreOwner(storeId) || belongsToStore(storeId) || isSuperAdmin());
            allow write: if false;
        }
      }
      match /beya3_action_log/{actionId} {
        allow read: if request.auth != null && (isStoreOwner(storeId) || belongsToStore(storeId) || isSuperAdmin());
        allow write: if false; // Only backend writes to audit logs
      }
      match /action_drafts/{draftId} {
        allow read, write: if request.auth != null && (isOwnerOrManager(storeId) || isSuperAdmin());
      }
      match /beya3_scheduled_insights/{insightId} {
        allow read: if request.auth != null && (isStoreOwner(storeId) || belongsToStore(storeId) || isSuperAdmin());
        allow update: if request.auth != null && (isStoreOwner(storeId) || belongsToStore(storeId) || isSuperAdmin()) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'isDismissed', 'userFeedback']);
        allow create, delete: if false; // Backend only
      }
      
      // Global configuration and stats (Beya3 Bot)
      match /whatsapp_conversations/{phone} {
         allow read, write: if request.auth != null && (isOwnerOrManager(storeId) || isSuperAdmin());
      }
      // WhatsApp Templates (Meta-approved templates registry)
      match /whatsapp_templates/{templateName} {
         allow read: if request.auth != null && (isStoreOwner(storeId) || belongsToStore(storeId) || isSuperAdmin());
         allow write: if request.auth != null && (isStoreOwner(storeId) || isSuperAdmin());
      }
      // WhatsApp Message Logs (audit trail)
      match /whatsapp_logs/{logId} {
         allow read: if request.auth != null && (isStoreOwner(storeId) || belongsToStore(storeId) || isSuperAdmin() || (isFranchiseAdmin() && inSameFranchise(storeId)));
         allow create: if request.auth != null && (isStoreOwner(storeId) || belongsToStore(storeId) || isSuperAdmin());
      }
      // Notifications (WhatsApp handoff + general)
      match /notifications/{notifId} {
         allow read: if request.auth != null && (isStoreOwner(storeId) || belongsToStore(storeId) || isSuperAdmin());
         allow write: if request.auth != null && (isStoreOwner(storeId) || belongsToStore(storeId) || isSuperAdmin());
      }
      // YouCan Integration
      match /youcan_integration/{docId} {
         allow read: if request.auth != null && (isStoreOwner(storeId) || belongsToStore(storeId) || isSuperAdmin());
         allow write: if request.auth != null && (isStoreOwner(storeId) || isSuperAdmin());
      }
      match /youcan_orders/{orderId} {
         allow read: if request.auth != null && (isStoreOwner(storeId) || belongsToStore(storeId) || isSuperAdmin());
         allow write: if request.auth != null && (isStoreOwner(storeId) || isSuperAdmin());
      }
    }

    // Products
    match /products/{productId} {
       allow read: if (request.auth != null && (isStoreOwner(resource.data.storeId) || (belongsToStore(resource.data.storeId) && !isDriver(resource.data.storeId)) || isSuperAdmin())) || isPublicCatalogEnabled(resource.data.storeId);
       allow create: if request.auth != null && (isStoreOwner(request.resource.data.storeId) || (belongsToStore(request.resource.data.storeId) && !isDriver(request.resource.data.storeId)) || isSuperAdmin()) && isValidProduct(request.resource.data);
       allow update: if request.auth != null && (isStoreOwner(resource.data.storeId) || (belongsToStore(resource.data.storeId) && !isDriver(resource.data.storeId)) || isSuperAdmin() || (isFranchiseAdmin() && inSameFranchise(resource.data.storeId))) && isValidProduct(request.resource.data) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['storeId']);
       allow delete: if request.auth != null && (isStoreOwner(resource.data.storeId) || (belongsToStore(resource.data.storeId) && !isDriver(resource.data.storeId)) || isSuperAdmin() || (isFranchiseAdmin() && inSameFranchise(resource.data.storeId)));
    }

    // Warehouses
    match /warehouses/{warehouseId} {
       allow read: if request.auth != null && (isStoreOwner(resource.data.storeId) || resource.data.storeId == getUserData().get('storeId', '') || isSuperAdmin());
       allow create: if request.auth != null && (isStoreOwner(request.resource.data.storeId) || request.resource.data.storeId == getUserData().get('storeId', '') || isSuperAdmin());
       allow update, delete: if request.auth != null && (isStoreOwner(resource.data.storeId) || resource.data.storeId == getUserData().get('storeId', '') || isSuperAdmin());
    }

    // Driver Sessions (for anonymous driver auth)
    match /driver_sessions/{uid} {
       allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    
    // Orders
    match /orders/{orderId} {
       allow read: if request.auth != null && (
         isStoreOwner(resource.data.storeId) ||
         (resource.data.storeId == getUserData().get('storeId', '') && !isDriver(resource.data.storeId)) ||
         isSuperAdmin() ||
         (isFranchiseAdmin() && inSameFranchise(resource.data.storeId)) ||
         resource.data.livreurToken == request.auth.uid ||
         (isDriver(resource.data.storeId) && resource.data.assignedDriver == request.auth.uid) ||
         (exists(/databases/$(database)/documents/driver_sessions/$(request.auth.uid)) && resource.data.livreurToken == get(/databases/$(database)/documents/driver_sessions/$(request.auth.uid)).data.token)
       );
                      
       allow create: if isValidOrder(request.resource.data) && (
                         (request.auth != null && (isStoreOwner(request.resource.data.storeId) || (request.resource.data.storeId == getUserData().get('storeId', '') && !isDriver(request.resource.data.storeId)) || isSuperAdmin()))
                         || (request.resource.data.status == 'pending_catalog' && isPublicCatalogEnabled(request.resource.data.storeId))
                      );
                          
       allow update: if isValidOrder(request.resource.data) && request.auth != null && (isStoreOwner(resource.data.storeId) || (resource.data.storeId == getUserData().get('storeId', '') && !isDriver(resource.data.storeId)) || isSuperAdmin() || (isFranchiseAdmin() && inSameFranchise(resource.data.storeId))) &&
                         isValidTransition(resource.data.status, request.resource.data.status) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['storeId']);
       
       allow update: if request.auth != null && (
                            // Chemin sûr d'abord (pas de getUserData(), qui plante si le livreur n'a pas de doc users)
                            resource.data.livreurToken == request.auth.uid ||
                            (exists(/databases/$(database)/documents/driver_sessions/$(request.auth.uid)) && resource.data.livreurToken == get(/databases/$(database)/documents/driver_sessions/$(request.auth.uid)).data.token) ||
                            (isDriver(resource.data.storeId) && resource.data.assignedDriver == request.auth.uid)
                         ) &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'statusHistory', 'isPaid', 'codCollected', 'codCollectedAt', 'driverNote', 'deliveryNote', 'deliveredAt', 'remarksHistory']) &&
                         isValidTransition(resource.data.status, request.resource.data.status) &&
                         request.resource.data.status in ['livraison', 'livré', 'retour', 'retour en cours', 'pas de réponse', 'reporté'];
                         
       allow delete: if request.auth != null && (isStoreOwner(resource.data.storeId) || (resource.data.storeId == getUserData().get('storeId', '') && !isDriver(resource.data.storeId)) || isSuperAdmin());
    }

    // Expenses
    match /expenses/{expenseId} {
       allow read, delete: if request.auth != null && (isOwnerOrManager(resource.data.storeId) || isSuperAdmin());
       allow create: if request.auth != null && (isOwnerOrManager(request.resource.data.storeId) || isSuperAdmin()) && isValidExpense(request.resource.data);
       allow update: if request.auth != null && (isOwnerOrManager(resource.data.storeId) || isSuperAdmin()) && isValidExpense(request.resource.data) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['storeId']);
    }

    // Customers
    match /customers/{customerId} {
       allow read, delete: if request.auth != null && (isStoreOwner(resource.data.storeId) || belongsToStore(resource.data.storeId) || isSuperAdmin());
       allow update: if request.auth != null && (isStoreOwner(resource.data.storeId) || belongsToStore(resource.data.storeId) || isSuperAdmin()) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['storeId']);
       allow create: if request.auth != null && (isStoreOwner(request.resource.data.storeId) || belongsToStore(request.resource.data.storeId) || isSuperAdmin());
    }

    // Team Management
    match /allowed_users/{userId} {
       allow read: if request.auth != null && (resource.data.email == request.auth.token.email || belongsToStore(resource.data.storeId) || isStoreOwner(resource.data.storeId) || isSuperAdmin());
       // SEC : seuls owner/manager gèrent l'équipe, et le rôle est contraint à staff/manager.
       // onUserWrite dérive le claim de rôle depuis allowed_users.role → sans ces gardes, tout
       // membre (staff/driver) pourrait s'auto-écrire role:'owner' et escalader ses privilèges.
       allow create: if request.auth != null
                     && (isOwnerOrManager(request.resource.data.storeId) || isSuperAdmin())
                     && request.resource.data.role in ['staff', 'manager'];
       allow update: if request.auth != null
                     && (isOwnerOrManager(resource.data.storeId) || isSuperAdmin())
                     && request.resource.data.role in ['staff', 'manager']
                     && request.resource.data.storeId == resource.data.storeId;
       allow delete: if request.auth != null && (isOwnerOrManager(resource.data.storeId) || isSuperAdmin());
    }

    // Public Leads — validated, no auth required but fields are enforced
    match /leads/{leadId} {
       // SEC: Validate required fields to prevent spam/injection
       allow create: if request.resource.data.keys().hasAll(['storeId', 'name', 'phone'])
                     && request.resource.data.name is string
                     && request.resource.data.name.size() > 0
                     && request.resource.data.name.size() <= 200
                     && request.resource.data.phone is string
                     && request.resource.data.phone.size() > 0
                     && request.resource.data.storeId is string;
       allow read: if request.auth != null && (belongsToStore(resource.data.storeId) || isStoreOwner(resource.data.storeId) || isSuperAdmin());
    }

    // Incidents
    match /incidents/{incidentId} {
      allow read: if request.auth != null && (isStoreOwner(resource.data.storeId) || belongsToStore(resource.data.storeId) || isSuperAdmin());
      allow create: if request.auth != null && (isStoreOwner(request.resource.data.storeId) || belongsToStore(request.resource.data.storeId) || isSuperAdmin());
      allow update, delete: if request.auth != null && (isStoreOwner(resource.data.storeId) || belongsToStore(resource.data.storeId) || isSuperAdmin());
    }

    // Custom Events
    match /events/{eventId} {
       allow read: if request.auth != null && (isStoreOwner(resource.data.storeId) || resource.data.storeId == getUserData().get('storeId', '') || isSuperAdmin() || (isFranchiseAdmin() && inSameFranchise(resource.data.storeId)));
       allow create: if request.auth != null && (isStoreOwner(request.resource.data.storeId) || request.resource.data.storeId == getUserData().get('storeId', '') || isSuperAdmin());
       allow update, delete: if request.auth != null && (isStoreOwner(resource.data.storeId) || resource.data.storeId == getUserData().get('storeId', '') || isSuperAdmin());
    }
    // Product Collections
    match /collections/{collectionId} {
       allow read: if true;
       allow create: if request.auth != null && (isStoreOwner(request.resource.data.storeId) || request.resource.data.storeId == getUserData().get('storeId', '') || isSuperAdmin());
       allow update, delete: if request.auth != null && (isStoreOwner(resource.data.storeId) || resource.data.storeId == getUserData().get('storeId', '') || isSuperAdmin());
    }

    // System Announcements
    match /system/announcements {
        allow read: if true;
        allow write: if request.auth != null && isSuperAdmin();
    }

    // Assets
    match /assets/{assetId} {
      allow read: if request.auth != null && (isStoreOwner(resource.data.storeId) || belongsToStore(resource.data.storeId) || isSuperAdmin());
      allow create: if request.auth != null && (isStoreOwner(request.resource.data.storeId) || belongsToStore(request.resource.data.storeId) || isSuperAdmin());
      allow update, delete: if request.auth != null && (isStoreOwner(resource.data.storeId) || belongsToStore(resource.data.storeId) || isSuperAdmin());
    }

    // Franchises collection
    match /franchises/{franchiseId} {
        allow read: if request.auth != null && (
          isSuperAdmin() ||
          (isFranchiseAdmin() && getUserData().franchiseId == franchiseId)
        );
        allow write: if request.auth != null && isSuperAdmin();
    }

    // Promo Codes (Beta Rewards)
    match /promo_codes/{storeId} {
        // Only super admins can list all codes
        allow list: if isSuperAdmin();
        // A store owner can read their own reward code
        allow get: if request.auth != null && (isStoreOwner(storeId) || isSuperAdmin());
        // A store owner can create/claim their reward code
        allow create: if request.auth != null && (isStoreOwner(storeId) || isSuperAdmin());
        // Only super admins can mark as used
        allow update: if isSuperAdmin();
        allow delete: if isSuperAdmin();
    }


    // Driver Applications — validated, no auth required but fields enforced
    match /driverApplications/{appId} {
        // SEC: Validate required fields to prevent spam
        allow create: if request.resource.data.keys().hasAll(['storeId', 'name', 'phone'])
                      && request.resource.data.name is string
                      && request.resource.data.name.size() > 0
                      && request.resource.data.storeId is string;
        allow read, update, delete: if request.auth != null && (
            isSuperAdmin() ||
            belongsToStore(resource.data.storeId) ||
            isStoreOwner(resource.data.storeId)
        );
    }

    // Drivers
    match /drivers/{driverId} {
        allow read: if request.auth != null && (
            isSuperAdmin() ||
            belongsToStore(resource.data.storeId) ||
            isStoreOwner(resource.data.storeId) ||
            (isFranchiseAdmin() && inSameFranchise(resource.data.storeId))
        );
        allow write: if request.auth != null && (
            isSuperAdmin() ||
            belongsToStore(resource.data.storeId) ||
            isStoreOwner(resource.data.storeId)
        );
        allow create: if request.auth != null && (
            isSuperAdmin() ||
            isStoreOwner(request.resource.data.storeId)
        );
    }

    // Employees
    match /employees/{employeeId} {
        allow read: if request.auth != null && (
            isSuperAdmin() ||
            belongsToStore(resource.data.storeId) ||
            isStoreOwner(resource.data.storeId) ||
            (isFranchiseAdmin() && inSameFranchise(resource.data.storeId))
        );
        allow create: if request.auth != null && (
            isSuperAdmin() ||
            isStoreOwner(request.resource.data.storeId) ||
            request.resource.data.storeId == getUserData().get('storeId', '')
        );
        allow update, delete: if request.auth != null && (
            isSuperAdmin() ||
            belongsToStore(resource.data.storeId) ||
            isStoreOwner(resource.data.storeId)
        );

        match /absences/{absenceId} {
            allow read, write: if request.auth != null && (
                isSuperAdmin() ||
                isStoreOwner(get(/databases/$(database)/documents/employees/$(employeeId)).data.storeId) ||
                get(/databases/$(database)/documents/employees/$(employeeId)).data.storeId == getUserData().get('storeId', '')
            );
        }

        match /payroll_history/{payrollId} {
            allow read, write: if request.auth != null && (
                isSuperAdmin() ||
                isStoreOwner(get(/databases/$(database)/documents/employees/$(employeeId)).data.storeId) ||
                get(/databases/$(database)/documents/employees/$(employeeId)).data.storeId == getUserData().get('storeId', '')
            );
        }
    }

    // Purchase Orders
    match /purchase_orders/{orderId} {
        allow read: if request.auth != null && (
            isSuperAdmin() ||
            belongsToStore(resource.data.storeId) ||
            isStoreOwner(resource.data.storeId) ||
            (isFranchiseAdmin() && inSameFranchise(resource.data.storeId))
        );
        allow create: if request.auth != null && (
            isSuperAdmin() ||
            isStoreOwner(request.resource.data.storeId) ||
            request.resource.data.storeId == getUserData().get('storeId', '')
        );
        allow update, delete: if request.auth != null && (
            isSuperAdmin() ||
            belongsToStore(resource.data.storeId) ||
            isStoreOwner(resource.data.storeId)
        );

        match /receptions/{receptionId} {
            allow read, write: if request.auth != null && (
                isSuperAdmin() ||
                isStoreOwner(get(/databases/$(database)/documents/purchase_orders/$(orderId)).data.storeId) ||
                get(/databases/$(database)/documents/purchase_orders/$(orderId)).data.storeId == getUserData().get('storeId', '')
            );
        }
    }

    // SAV Returns
    match /returns/{returnId} {
        allow read: if request.auth != null && (
            isSuperAdmin() ||
            belongsToStore(resource.data.storeId) ||
            isStoreOwner(resource.data.storeId) ||
            (isFranchiseAdmin() && inSameFranchise(resource.data.storeId))
        );
        allow create: if request.auth != null && (
            isSuperAdmin() ||
            isStoreOwner(request.resource.data.storeId) ||
            request.resource.data.storeId == getUserData().get('storeId', '')
        );
        allow update, delete: if request.auth != null && (
            isSuperAdmin() ||
            belongsToStore(resource.data.storeId) ||
            isStoreOwner(resource.data.storeId)
        );
    }
    // SAV Refunds
    match /refunds/{refundId} {
        allow read: if request.auth != null && (
            isSuperAdmin() ||
            belongsToStore(resource.data.storeId) ||
            isStoreOwner(resource.data.storeId) ||
            (isFranchiseAdmin() && inSameFranchise(resource.data.storeId))
        );
        allow create: if request.auth != null && (
            isSuperAdmin() ||
            isStoreOwner(request.resource.data.storeId) ||
            request.resource.data.storeId == getUserData().get('storeId', '')
        );
        allow update, delete: if request.auth != null && (
            isSuperAdmin() ||
            belongsToStore(resource.data.storeId) ||
            isStoreOwner(resource.data.storeId)
        );
    }
  }
}
